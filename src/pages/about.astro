---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getImage } from "astro:assets";
import Content2 from "../components/widgets/Content2.astro";
import Values from "../components/widgets/Values.astro";
import aboutImage from "../assets/images/about-office.webp";

const metadata = {
    title: "Quien soy",
    description:
        "Conoce la visión de un pseudo-ingeniero con poco tiempo libre, motivado por el Free and Open Source Software y el odio hacia las corporaciones y el DRM.",
};

const values = [
    {
        title: "Innovation",
        description:
            "Curabitur dignissim, felis non sollicitudin molestie, urna mauris pellentesque velit, ut eleifend.",
    },
    {
        title: "Commitment",
        description:
            "Aenean condimentum finibus mauris, a fermentum justo pan eget. Sed ultricies, neque quis.",
    },
    {
        title: "Quality",
        description:
            "Donec sed orci tincidunt, aliquam nisl a, condimentum nunc. Nulla varius ex nec ante feugiat.",
    },
    {
        title: "Transparency",
        description:
            "Phasellus tristique, elit dapibus cursus facilisis, lorem augue fringilla nunc, vitae fermentum.",
    },
    {
        title: "Teamwork",
        description:
            "In hac habitasse platea dictumst. Vivamus adipiscing fermentum quam volutpat aliquam. Integer et.",
    },
    {
        title: "Excellence",
        description:
            "Fusce at massa nec sapien auctor gravida in in tellus. Vivamus a tristique metus, et molestie.",
    },
];

const optimizedImage = await getImage({
    src: aboutImage,
    format: "webp",
});
---

<BaseLayout {metadata}>
    <link slot="head" rel="preload" href={optimizedImage.src} as="image" />
    <Content2
        title="Quien pishula soy"
        description={[
            "Hola, soy Erick, un pseudo-ingeniero con poco tiempo libre, motivado por el Free and Open Source Software y el odio hacia las corporaciones y el DRM.",
            "Me especializo en el despliegue en producción, gestiones de servidores Linux, y disfruto explorando nuevas herramientas y soluciones para mejorar mi flujo de trabajo.",
          
        ]}
        tagline="About"
        image={aboutImage}
        imageAlt="Modern web development office"
        actions={[
            {
                text: "Contact Us",
                href: "/contact",
                variant: "primary",
                icon: "lucide:mail",
            },
            {
                text: "View Details",
                href: "#",
                variant: "secondary",
                icon: "lucide:arrow-right",
            },
        ]}
    />
    <Values
        items={values}
        columns={3}
        tagline="Our Values"
        title="What Defines Us"
        subtitle="Principles that guide our daily work"
    />
</BaseLayout>
